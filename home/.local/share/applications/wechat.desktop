[Desktop Entry]
Name=wechat
Name[zh_CN]=微信
Exec=env  QT_QPA_PLATFORM=wayland QT_IM_MODULE=text-input-unstable-v3 /opt/wechat/wechat %U
StartupNotify=true
Terminal=false
Icon=/usr/share/icons/hicolor/256x256/apps/wechat.png
Type=Application
Categories=Utility;
Comment=Wechat Desktop
Comment[zh_CN]=微信桌面版
